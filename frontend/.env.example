# Laravel API, called from the Next.js server only (never from the browser).
API_URL=http://127.0.0.1:8000

# Shown in titles and footers.
NEXT_PUBLIC_APP_NAME=TIQS

# Public address of this site, shown in links users share (no trailing slash).
NEXT_PUBLIC_APP_URL=https://itsmycontactinfo.com


# Single sign-on from itsmycontact.info: sites whose login form may post to /login/sso,
# and where to send a failed login when the form gives no return page.
SSO_ALLOWED_ORIGINS=https://itsmycontact.info,https://www.itsmycontact.info
SSO_ERROR_RETURN_URL=https://itsmycontact.info/login
